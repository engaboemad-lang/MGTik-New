<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme for Jetpack Compose Activity -->
    <style name="Theme.MgtikHotspot" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Android 12+ / Jetpack Core SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash window -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>

        <!-- Centerpiece icon drawable -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">800</item>

        <!-- Post-splash screen theme to apply to MainActivity once loaded -->
        <item name="postSplashScreenTheme">@style/Theme.MgtikHotspot</item>
    </style>
</resources>
